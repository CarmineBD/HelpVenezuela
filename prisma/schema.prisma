generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HelpPostKind {
  NEED
  OFFER
}

enum HelpPostStatus {
  ACTIVE
  HIDDEN
  CLOSED
  DELETED
  REPORTED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum LocationSource {
  ADDRESS
  CURRENT_LOCATION
}

model Person {
  id           String     @id @default(cuid())
  identityCard String     @unique
  name         String?
  surnames     String?
  contact      String?
  helpPosts    HelpPost[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model HelpPost {
  id            String         @id @default(cuid())
  personId      String
  person        Person         @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind          HelpPostKind
  name          String
  surnames      String?
  contact       String
  locationSource LocationSource @default(ADDRESS)
  state         String?
  city          String?
  address       String?
  referencePoint String?
  locationLabel String
  latitude      Float
  longitude     Float
  publicLatitude  Float
  publicLongitude Float
  timeFrom      String?
  timeTo        String?
  urgency       Urgency?
  description   String
  status        HelpPostStatus @default(ACTIVE)
  helpTypes     HelpPostType[]
  reports       HelpPostReport[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([personId])
  @@index([kind, status])
  @@index([publicLatitude, publicLongitude])
  @@index([timeFrom, timeTo])
}

model HelpType {
  id        String         @id @default(cuid())
  slug      String         @unique
  name      String
  active    Boolean        @default(true)
  sortOrder Int            @default(0)
  helpPosts HelpPostType[]
}

model HelpPostType {
  helpPostId String
  helpTypeId String
  helpPost   HelpPost @relation(fields: [helpPostId], references: [id], onDelete: Cascade)
  helpType   HelpType @relation(fields: [helpTypeId], references: [id], onDelete: Cascade)

  @@id([helpPostId, helpTypeId])
  @@index([helpTypeId])
}

model HelpPostReport {
  id         String   @id @default(cuid())
  helpPostId String
  reason     String
  message    String?
  helpPost   HelpPost @relation(fields: [helpPostId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([helpPostId])
}
