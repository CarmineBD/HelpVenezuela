{
  "name": "help-venezuela",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @help-venezuela/shared --filter @help-venezuela/api --filter @help-venezuela/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @help-venezuela/shared build && pnpm -r typecheck",
    "db:generate": "dotenv -e .env -- pnpm --filter @help-venezuela/api exec prisma generate --schema ../../prisma/schema.prisma",
    "db:migrate": "dotenv -e .env -- pnpm --filter @help-venezuela/api exec prisma migrate dev --schema ../../prisma/schema.prisma",
    "db:studio": "dotenv -e .env -- pnpm --filter @help-venezuela/api exec prisma studio --schema ../../prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "dotenv-cli": "^7.4.4",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2"
  }
}
